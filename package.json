{
  "name": "rommo-cloudflare",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply rommo-db --remote",
    "db:seed": "wrangler d1 execute rommo-db --remote --file=seed_products.sql",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python -m unittest discover -s tests -p \"test_*.py\" -v"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
